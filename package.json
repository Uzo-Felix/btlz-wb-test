{
    "name": "btlz-test",
    "version": "1.0.0",
    "description": "WB Tariff Service with Google Sheets Integration",
    "main": "app.js",
    "type": "module",
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec tsx src/app.ts",
        "watch:build": "tsc --build --force --verbose --watch",
        "knex:dev": "tsx src/utils/knex.ts",
        "build": "tsc --allowJs",
        "start": "node dist/app.js",
        "knex": "node dist/utils/knex.js",
        "tsc:check": "tsc --allowJs --noEmit",
        "prettier": "prettier --config .prettierrc.json src/**/*.ts --check",
        "prettier-format": "prettier --config .prettierrc.json src/**/*.ts --write",
        "eslint": "eslint src/**/*.ts",
        "eslint-fix": "eslint --fix src/**/*.ts",
        "test:services": "tsx src/utils/test-services.ts",
        "test:wb-api": "tsx -e \"import('./src/services/wildberries.service.js').then(m => new m.WildberriesService().fetchTariffData('2024-03-01'))\"",
        "test:db": "tsx -e \"import('./src/services/database.service.js').then(m => new m.DatabaseService().getLatestTariffData())\"",
        "migrate:latest": "npm run knex:dev migrate latest",
        "migrate:rollback": "npm run knex:dev migrate rollback",
        "seed:run": "npm run knex:dev seed run"
    },
    "imports": {
        "#*": [
            "./dist/*",
            "./src/*"
        ]
    },
    "author": "lucard17",
    "license": "ISC",
    "dependencies": {
        "commander": "^13.1.0",
        "dotenv": "^16.3.1",
        "express": "^5.1.0",
        "googleapis": "^144.0.0",
        "knex": "^3.0.1",
        "log4js": "^6.9.1",
        "pg": "^8.11.3",
        "tsx": "^4.20.3",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@babel/core": "^7.23.6",
        "@babel/preset-env": "^7.23.6",
        "@babel/preset-typescript": "^7.24.7",
        "@types/express": "^5.0.3",
        "@types/node": "^20.0.0",
        "@types/pg": "^8.11.10",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^9.1.0",
        "nodemon": "^3.0.2",
        "prettier": "^3.3.3",
        "typescript": "^5.7.3"
    }
}
